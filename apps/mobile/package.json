{
  "name": "@fitnessapp/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "content:bundle": "node ../../scripts/bundle-content.mjs src/generated/content-files.ts --empty-if-supabase",
    "dev": "node ../../scripts/bundle-content.mjs src/generated/content-files.ts --empty-if-supabase && node scripts/copy-scanner-wasm.mjs && expo start",
    "build": "node ../../scripts/bundle-content.mjs src/generated/content-files.ts --empty-if-supabase && node scripts/copy-scanner-wasm.mjs && expo export --platform web",
    "lint": "eslint .",
    "typecheck": "node ../../scripts/bundle-content.mjs src/generated/content-files.ts --empty-if-supabase && tsc --noEmit",
    "test": "node ../../scripts/bundle-content.mjs src/generated/content-files.ts --empty-if-supabase && vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "pdf:preview": "node ../../scripts/bundle-content.mjs src/generated/content-files.ts --empty-if-supabase && tsx scripts/pdf-preview.ts",
    "eas-build-post-install": "node ../../scripts/bundle-content.mjs src/generated/content-files.ts --empty-if-supabase",
    "screenshots": "SCREENSHOT_DIR=${SCREENSHOT_DIR:-screenshots} playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "0.4.2",
    "@fitnessapp/content": "workspace:*",
    "@fitnessapp/core": "workspace:*",
    "@fitnessapp/db": "workspace:*",
    "@fitnessapp/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "barcode-detector": "3.2.2",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health-connect": "4.1.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "~19.2.2",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15"
  }
}
