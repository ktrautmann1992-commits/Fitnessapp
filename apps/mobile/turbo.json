{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/content/**",
        "$TURBO_ROOT$/scripts/bundle-content.mjs"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/content/**",
        "$TURBO_ROOT$/scripts/bundle-content.mjs"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/content/**",
        "$TURBO_ROOT$/scripts/bundle-content.mjs"
      ]
    }
  }
}
