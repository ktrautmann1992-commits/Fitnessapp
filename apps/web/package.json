{
  "name": "@fitnessapp/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "content:bundle": "node ../../scripts/bundle-content.mjs src/generated/content-files.ts",
    "dev": "node ../../scripts/bundle-content.mjs src/generated/content-files.ts && next dev",
    "build": "node ../../scripts/bundle-content.mjs src/generated/content-files.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node ../../scripts/bundle-content.mjs src/generated/content-files.ts && next typegen && tsc --noEmit",
    "test": "node ../../scripts/bundle-content.mjs src/generated/content-files.ts && vitest run",
    "test:e2e": "playwright test",
    "screenshots": "SCREENSHOT_DIR=${SCREENSHOT_DIR:-screenshots} playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@fitnessapp/core": "workspace:*",
    "@fitnessapp/db": "workspace:*",
    "@fitnessapp/ui": "workspace:*",
    "next": "^16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2"
  }
}
