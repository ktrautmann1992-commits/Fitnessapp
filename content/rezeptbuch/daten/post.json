  "recipes": [
    {
      "mahlzeit": "Direkt danach",
      "name": "Beeren-Hafer-Recovery-Shake",
      "beschreibung": "Cremiger Sojadrink-Shake mit veganem Protein, Beeren und Hafer – liefert direkt nach dem Training schnell verfügbares Eiweiß und Kohlenhydrate zum Auffüllen.",
      "zeit_min": 5,
      "tags": [
        "Nach dem Training",
        "Unter 10 Minuten"
      ],
      "passt_fuer": [
        "vegan",
        "vegetarisch",
        "fleisch",
        "ohne-schwein"
      ],
      "zutaten": [
        {
          "name": "Sojadrink ungesüßt",
          "menge_g": 250,
          "anzeige": "250 ml"
        },
        {
          "name": "Veganes Proteinpulver (Vanille)",
          "menge_g": 30,
          "anzeige": "1 Messlöffel (30 g)"
        },
        {
          "name": "Beerenmischung (TK)",
          "menge_g": 100,
          "anzeige": "100 g"
        },
        {
          "name": "Haferflocken",
          "menge_g": 30,
          "anzeige": "3 EL (30 g)"
        },
        {
          "name": "Zimt",
          "menge_g": 0,
          "anzeige": "1 Prise"
        }
      ],
      "zubereitung": [
        "Gib den Sojadrink und die gefrorenen Beeren in einen Mixer.",
        "Füge Proteinpulver, Haferflocken und Zimt hinzu.",
        "Mixe alles etwa 30 Sekunden auf höchster Stufe, bis der Shake cremig ist.",
        "Gieße den Shake in ein Glas und trink ihn möglichst zeitnah nach dem Training."
      ],
      "tipp": "Für unterwegs Haferflocken und Pulver vorab in den Shaker füllen und im Gym nur noch Sojadrink zugeben – dann die Beeren weglassen und eine Banane dazu essen. Ohne Pulver: 250 g Sojaskyr natur statt Pulver und 150 ml Sojadrink verwenden."
    },
    {
      "mahlzeit": "Direkt danach",
      "name": "Kirsch-Skyr-Becher mit Hafer-Crunch",
      "beschreibung": "Viel Eiweiß aus Skyr plus Sauerkirschen, Hafer und Honig – schnell gegessen, leicht verdaulich und ideal, um die Speicher nach dem Training wieder aufzufüllen.",
      "zeit_min": 5,
      "tags": [
        "Nach dem Training",
