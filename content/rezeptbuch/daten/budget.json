  "recipes": [
    {
      "mahlzeit": "Frühstück",
      "passt_fuer": [
        "vegan",
        "vegetarisch",
        "fleisch",
        "ohne-schwein"
      ],
      "name": "Bananen-Vanille-Porridge mit Sojadrink",
      "beschreibung": "Cremiger Haferbrei aus Eigenmarken-Haferflocken, der mit Sojadrink und einem Messlöffel Proteinpulver lange satt macht und kaum mehr als einen Euro kostet.",
      "zeit_min": 8,
      "kosten_eur": 1.17,
      "tags": [
        "Spar-Küche",
        "Unter 10 Minuten"
      ],
      "zutaten": [
        {
          "name": "Haferflocken",
          "menge_g": 70,
          "anzeige": "70 g"
        },
        {
          "name": "Sojadrink ungesüßt",
          "menge_g": 250,
          "anzeige": "250 ml"
        },
        {
          "name": "Veganes Proteinpulver (Vanille)",
          "menge_g": 20,
          "anzeige": "1 Messlöffel (20 g)"
        },
        {
          "name": "Banane",
          "menge_g": 100,
          "anzeige": "1 kleine Banane (100 g)"
        },
        {
          "name": "Zimt",
          "menge_g": 0,
          "anzeige": "1 Prise"
        }
      ],
      "zubereitung": [
        "Bring die Haferflocken mit 200 ml Sojadrink in einem kleinen Topf bei mittlerer Hitze unter Rühren zum Köcheln.",
        "Lass den Brei 3–4 Minuten sanft quellen, bis er cremig ist, und nimm ihn dann vom Herd.",
        "Verrühre das Proteinpulver mit dem restlichen Sojadrink glatt und rühre es unter den etwas abgekühlten Brei.",
        "Schneide die Banane in Scheiben, gib sie auf das Porridge und bestreue alles mit Zimt."
      ],
      "tipp": "Ohne Pulver: Rühr 2 EL Erdnussmus und 150 g Sojaskyr natur unter – etwas teurer, aber ähnlich eiweißreich. Überreife Bananen gibt es oft reduziert, die sind hier ideal."
    },
    {
      "mahlzeit": "Frühstück",
