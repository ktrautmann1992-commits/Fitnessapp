# Vorlage für alle Umgebungsvariablen. NIE echte Werte in dieses Repository eintragen!
# Wo welcher Wert eingetragen wird, steht in docs/SETUP.md (Tabelle „Welcher Schlüssel wohin?“).

# --- App (apps/mobile) – Vercel-Projekt „App“ und Expo/EAS-Umgebungsvariablen ---
# Öffentlich (landet im App-Code). Schutz der Daten über Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Website (apps/web) – Vercel-Projekt „Web“ ---
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Nur Server / GitHub Actions (GEHEIM – niemals mit EXPO_PUBLIC_ oder NEXT_PUBLIC_ beginnen) ---
# Für content-generate und content-seed (Schreibzugriff auf Inhalte).
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Für db-migrate (Datenbank-Migrationen).
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=...
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst

# Für content-generate (Claude Batch-API).
ANTHROPIC_API_KEY=sk-ant-...

# Für eas-build (App-Builds in der Expo-Cloud).
EXPO_TOKEN=...
