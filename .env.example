# Vorlage für alle Umgebungsvariablen. NIE echte Werte in dieses Repository eintragen!
# Wo welcher Wert eingetragen wird, steht in docs/SETUP.md (Tabelle „Welcher Schlüssel wohin?“).

# --- App (apps/mobile) – Vercel-Projekt „App“ und Expo/EAS-Umgebungsvariablen ---
# Öffentlich (landet im App-Code). Schutz der Daten über Row Level Security.
# Fehlen beide Werte, startet die App im TESTMODUS (alle Daten nur auf dem Gerät).
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Adresse der Website (apps/web) für „Per Foto“ (Etappe E3). Fehlt sie, ist „Per Foto“ im Supabase-Modus nicht verfügbar.
EXPO_PUBLIC_WEB_URL=https://fitnessapp-web-eight.vercel.app

# --- Website (apps/web) – Vercel-Projekt „Web“ ---
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Adresse der App im Browser (Vercel-Projekt „App“) für den Link „App im Browser testen“ im Seitenfuß.
# Leer = https://fitnessapp-alpha-five.vercel.app
NEXT_PUBLIC_APP_URL=https://fitnessapp-alpha-five.vercel.app
# Redaktionsbereich /admin, Stufe A (GEHEIM, nur im Vercel-Projekt „Web“, Production + Preview – SETUP Teil G).
# Fehlt einer der Werte oder ist er zu kurz, ist /admin gesperrt. Beide verschieden, aus dem Passwort-Manager.
# Mindestens 20 zufällige Zeichen:
ADMIN_PASSWORD=
# Mindestens 32 zufällige Zeichen (signiert die Anmelde-Cookies; ändern = alle abmelden):
ADMIN_SESSION_SECRET=
# Öffentliche Adresse der Website (Open Graph, Sitemap, robots.txt). Leer = https://fitnessapp-web-eight.vercel.app
NEXT_PUBLIC_SITE_URL=
# Warteliste der Landingpage (GEHEIM außer FROM, nur Vercel-Projekt „Web“, Production + Preview – SETUP Teil I).
# Fehlt einer der Werte, zeigt das Formular „Die Warteliste ist bald aktiv“ (API antwortet 503).
RESEND_API_KEY=re_...
WAITLIST_FROM_EMAIL=Alpha5 <warteliste@mail.DEINE-DOMAIN.de>
# Mindestens 32 zufällige Zeichen (sichert Bestätigungs-Links und IP-Prüfwerte):
WAITLIST_TOKEN_SECRET=
# Supabase „Secret key“ (sb_secret_…) bzw. alter service_role-Schlüssel – NIE mit NEXT_PUBLIC_ beginnen.
# Ersatzweise wird SUPABASE_SECRET_KEY gelesen. Die URL kommt aus NEXT_PUBLIC_SUPABASE_URL (oder SUPABASE_URL).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Gericht per Foto (Etappe E3, docs/SETUP.md Teil L) – Vercel-Projekt „Web“.
# Standard ist die ATTRAPPE (feste Beispielantworten, keine echte KI, keine Kosten). Die echte Foto-KI läuft NUR,
# wenn FOOD_PHOTO_PROVIDER=gemini UND GEMINI_API_KEY gesetzt sind (GEHEIM, nur Production bzw. gezielt Preview).
FOOD_PHOTO_PROVIDER=
# GEMINI_API_KEY steht unten (dieselbe Variable; im Vercel-Projekt „Web“ nur für die Foto-KI eintragen).
# Optional: Modell (nur mit hinterlegtem Preis in AI_FOOD_PHOTO, leer = gemini-3.5-flash-lite).
GEMINI_FOOD_PHOTO_MODEL=
# Adresse der App (Web-Export) für CORS der Route /api/ernaehrung/foto; optional das Team-Kürzel der App-Vorschauen.
APP_WEB_ORIGIN=https://fitnessapp-alpha-five.vercel.app
APP_PREVIEW_TEAM=

# --- Nur Server / GitHub Actions (GEHEIM – niemals mit EXPO_PUBLIC_ oder NEXT_PUBLIC_ beginnen) ---
# Für content-seed (Inhalte einspielen; Schreibzugriff).
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Nur content-seed, nur per Hand („Run workflow“, Häkchen allow_mass_archive): erlaubt, dass ein Lauf mehr als
# die Hälfte der freigegebenen Inhalte zurückzieht. Standard false – nie dauerhaft setzen.
ALLOW_MASS_ARCHIVE=false

# Für db-migrate (Datenbank-Migrationen).
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=...
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst

# Für content-generate und content-collect (Google Gemini Batch API, seit 15.10.2026; docs/SETUP.md Teil E).
# Nur als GitHub Secret eintragen – nie in den Code oder in den Chat. ANTHROPIC_API_KEY wird nicht mehr gebraucht.
GEMINI_API_KEY=AIza...

# --- Content-Pipeline: GitHub Variables (NICHT geheim, alle optional) ---
# Gemini-Modell für ALLE Arten (leer = Standard je Art: gemini-3.5-flash-lite für Austausch/Packungen,
# gemini-3.8-flash für Rezepte/Übungen/Vorlagen; nur Modelle mit Preis in packages/content/src/pipeline/pricing.ts).
# Einzelne Läufe: Workflow-Eingabe „modell“.
CONTENT_MODEL=
# Denktiefe (Gemini thinkingLevel): minimal | low | medium | high (leer = Standard je Art: low bzw. medium).
CONTENT_EFFORT=
# Kostendeckel pro Lauf in US-Dollar (schlimmster Fall, Standard: 3, höchstens 20). Darüber wird nichts gesendet.
CONTENT_MAX_USD=3

# Für eas-build (App-Builds in der Expo-Cloud).
EXPO_TOKEN=...
