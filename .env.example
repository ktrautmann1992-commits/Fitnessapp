# Vorlage für alle Umgebungsvariablen. NIE echte Werte in dieses Repository eintragen!
# Wo welcher Wert eingetragen wird, steht in docs/SETUP.md (Tabelle „Welcher Schlüssel wohin?“).

# --- App (apps/mobile) – Vercel-Projekt „App“ und Expo/EAS-Umgebungsvariablen ---
# Öffentlich (landet im App-Code). Schutz der Daten über Row Level Security.
# Fehlen beide Werte, startet die App im TESTMODUS (alle Daten nur auf dem Gerät).
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Website (apps/web) – Vercel-Projekt „Web“ ---
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Adresse der App im Browser (Vercel-Projekt „App“) für den Knopf „App im Browser öffnen“.
# Leer = https://fitnessapp-alpha-five.vercel.app
NEXT_PUBLIC_APP_URL=https://fitnessapp-alpha-five.vercel.app

# --- Nur Server / GitHub Actions (GEHEIM – niemals mit EXPO_PUBLIC_ oder NEXT_PUBLIC_ beginnen) ---
# Für content-seed (Inhalte einspielen; Schreibzugriff).
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Für db-migrate (Datenbank-Migrationen).
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=...
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst

# Für content-generate und content-collect (Claude Batch-API).
ANTHROPIC_API_KEY=sk-ant-...

# --- Content-Pipeline: GitHub Variables (NICHT geheim, alle optional) ---
# Modell für die Batch-Läufe (Standard: claude-opus-5-5).
CONTENT_MODEL=claude-opus-5-5
# Denktiefe: low | medium | high | xhigh | max (Standard: high).
CONTENT_EFFORT=high
# Kostendeckel pro Lauf in US-Dollar (schlimmster Fall, Standard: 15). Darüber wird nichts gesendet.
CONTENT_MAX_USD=15

# Für eas-build (App-Builds in der Expo-Cloud).
EXPO_TOKEN=...
