{
  "name": "@fitnessapp/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Geteilte Design-Tokens (Farben, Abstände, Schrift) für Mobile und Web. Quelle: theme.css.",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./theme.css"
  },
  "scripts": {
