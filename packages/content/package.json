{
  "name": "@fitnessapp/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Inhalte prüfen (content:validate), Content-Pipeline (Google Gemini Batch API: generate, collect, review) und Seed.",
  "scripts": {
    "validate": "tsx src/validate-cli.ts",
    "generate": "tsx src/generate-cli.ts",
    "collect": "tsx src/collect-cli.ts",
    "review": "tsx src/review-cli.ts",
    "seed": "tsx src/seed-cli.ts",
    "plan:examples": "tsx src/plan-examples-cli.ts",
    "nutrition:examples": "tsx src/nutrition-examples-cli.ts",
    "adjust:examples": "tsx src/adjust-examples-cli.ts",
    "supplements:examples": "tsx src/supplement-examples-cli.ts",
    "foods:import": "tsx src/foods-import-cli.ts",
    "sources:integrity": "tsx src/sources-integrity-cli.ts",
    "import-alpha5": "tsx src/import-alpha5-cli.ts",
    "illustrations": "tsx src/illustrations-cli.ts",
    "illustrations:check": "tsx src/illustrations-cli.ts --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "recipe-media": "tsx src/recipe-media-cli.ts",
    "recipe-media:check": "tsx src/recipe-media-cli.ts --check"
  },
  "dependencies": {
    "@fitnessapp/core": "workspace:*",
    "@fitnessapp/ui": "workspace:*",
    "@google/genai": "2.27.0",
    "prettier": "^3.9.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "exports": {
    "./catalog": "./src/foods/catalog-texts.ts",
    "./import-report": "./src/import/deviations.ts"
  }
}
