{
  "name": "@fitnessapp/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Inhalte prüfen (content:validate), Offline-Content-Generierung (Claude Batch-API) und Seeds.",
  "scripts": {
    "validate": "tsx src/validate-cli.ts",
